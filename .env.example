# DocFinder - конфигурация полного запуска через compose.yaml

# Обязательные секреты. Используйте три разные случайные строки.
DOCS_PASSWORD=
ENGINE_TOKEN=
POSTGRES_PASSWORD=

# Общие настройки
DEBUG=false
API_MODE=live
WEB_PORT=3000
API_PORT_LOCAL=8080

# PostgreSQL
POSTGRES_USER=docs
POSTGRES_DB=docfinder

# Провайдер моделей: ollama или openai
AI_PROVIDER=ollama

# OpenAI-compatible API. Нужны при AI_PROVIDER=openai.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMB_MODEL=bge-m3
RERANKER_MODEL=
TEMPERATURE=0
MAX_TOKENS=1200

# Ollama на хосте: http://host.docker.internal:11434
# Ollama в compose: http://ollama:11434
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_EMBED_DIMENSIONS=1024

# Пользователи и регистрация
ENABLE_SIGNUP=true
DEFAULT_USER_ROLE=pending
SHOW_ADMIN_DETAILS=true

# LDAP или Active Directory
ENABLE_LDAP=false
LDAP_SERVER_LABEL=LDAP
LDAP_SERVER_HOST=
LDAP_SERVER_PORT=
LDAP_APP_DN=
LDAP_APP_PASSWORD=
LDAP_ATTRIBUTE_FOR_USERNAME=sAMAccountName
LDAP_ATTRIBUTE_FOR_MAIL=mail
LDAP_SEARCH_BASE=
LDAP_SEARCH_FILTERS=
LDAP_USE_TLS=false
LDAP_VALIDATE_CERT=true
ENABLE_LDAP_GROUP_MANAGEMENT=false
LDAP_ATTRIBUTE_FOR_GROUPS=memberOf

# Web BFF
CORE_TIMEOUT_MS=120000
ADMIN_ACCESS_LEVEL=2
USER_ACCESS_LEVEL=1
SESSION_TTL_MINUTES=480

# Cookie и встраиваемый виджет
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
EMBED_ALLOWED_ORIGINS=

# Файлы и защита входа
MAX_UPLOAD_MB=20
ALLOWED_UPLOAD_EXTENSIONS=.txt .pdf .docx
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15
